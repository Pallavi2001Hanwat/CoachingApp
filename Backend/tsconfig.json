{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./",           // Important: root is current folder
    "outDir": "dist",          // Compiled JS goes into dist/
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"],     // All TS files in backend/
  "exclude": ["node_modules", "dist"]
}




